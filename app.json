{
  "expo": {
    "name": "Gravebreath",
    "slug": "gravebreath",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "bd.nexusbenders.gravebreath"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#030203",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "bd.nexusbenders.gravebreath",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-audio",
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Nosifer-Regular.ttf",
            "./assets/fonts/Creepster-Regular.ttf"
          ]
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "LANDSCAPE"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "scheme": "gravebreath",
    "backgroundColor": "#000000",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "31d921f6-45a3-498c-b09d-3d08e33b5296"
      }
    },
    "owner": "naffiziqbal"
  }
}
